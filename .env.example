# Copy to .env and fill in. .env is git-ignored — never commit it.

# ---- Public address ----------------------------------------------------------
# Both hostnames are public hostnames on the Cloudflare tunnel, pointing at http://caddy:80
SITE_HOST=hack.comet-tech.org
GIT_HOST=git.comet-tech.org

# ---- Cloudflare tunnel -------------------------------------------------------
# Zero Trust dashboard -> Networks -> Tunnels -> (your tunnel) -> copy the token
# from the "docker run ... --token <TOKEN>" install command.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- CI runner ---------------------------------------------------------------
# Filled in automatically by scripts/bootstrap.sh. Only used on first registration.
RUNNER_REGISTRATION_TOKEN=

# ---- Accounts ----------------------------------------------------------------
# false = students can sign up (teacher must still activate each account)
# true  = only admins can create accounts
GITEA_DISABLE_REGISTRATION=false
# Only these email domains may register (comma-separated). Admin-created accounts too.
GITEA_EMAIL_DOMAIN_ALLOWLIST=masonohioschools.com

# ---- Club website ------------------------------------------------------------
# The site is pulled from this Gitea repo. Until it exists, ./website is served.
SITE_REPO_URL=http://gitea:3000/hackclub/website.git
SITE_BRANCH=main
# Publish a sub-folder instead of the repo root (e.g. "public" for a built site)
SITE_DIR=
# Only needed if the website repo is not public: a Gitea token with read:repository
SITE_REPO_TOKEN=
SYNC_INTERVAL=60

# ---- Local testing -----------------------------------------------------------
# Caddy is also published on 127.0.0.1:$LOCAL_PORT on this machine only.
LOCAL_PORT=8088
